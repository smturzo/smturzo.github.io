@inproceedings{teneggi2026agentrosetta,
  abbr={ICML},
  bibtex_show={true},
  title={Protein Design with AgentRosetta: A Case Study for Specialized Scientific Agents},
  author={Teneggi, Jacopo and Turzo, S. M. Bargeen Alam and Marwah, Tanya and Bietti, Alberto and Renfrew, P. Douglas and Mulligan, Vikram Khipple and Golkar, Siavash},
  booktitle={International Conference on Machine Learning (ICML)},
  year={2026},
  selected={true},
  abstract={AgentRosetta is an LLM-based scientific agent integrated with the Rosetta modeling suite for physics-based protein design. Structured agent-environment interfaces enable iterative refinement of canonical and non-canonical protein designs, and we show that environment design is critical for reliable LLM control of complex scientific software.}
